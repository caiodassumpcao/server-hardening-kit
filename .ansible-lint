---
# Perfil mais rigoroso do ansible-lint: exige FQCN, nomes em todas as tasks,
# prefixo de variáveis por role, permissões explícitas em arquivos etc.
profile: production

exclude_paths:
  - .venv/
  - .github/
  - .devcontainer/
  - reports/
  - collections/

mock_roles: []
skip_list: []
warn_list: []

# As coleções são instaladas uma única vez por scripts/galaxy-install.sh (com
# retentativa e fallback para o GitHub); o lint não deve depender do Galaxy.
offline: true
